#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later

USE_PROCD=1
# After network and firewall, before anything that expects the tunnel.
START=95
STOP=10

EXTRA_COMMANDS="validate"
EXTRA_HELP="	validate	Check the configuration without starting anything"

. /usr/share/xray-wg/functions.sh

start_service() {
	local frontend iface port tries generation

	xwg_enabled || {
		xwg_log info "disabled in /etc/config/xray_wg; not starting"
		return 0
	}

	xwg_validate || {
		xwg_log err "configuration incomplete; not starting"
		return 1
	}

	frontend=$(xwg_get server frontend)
	iface=$(xwg_get wg iface)
	port=$(xwg_get settings local_port)

	# A leftover interface from a previous run would hold the default route
	# while we try to read the real uplink's gateway.
	ifdown "$iface" 2>/dev/null

	# Before pinning anything: a router upgraded from <= 1.0.6 may have no
	# default route at all, which would make the pin resolve against nothing.
	xwg_repair_upstream_default

	# On restart procd has only just signalled the previous xray, and the
	# socket outlives the process briefly. Three seconds turned out not to be
	# enough on a slow router: the start then refused with "port in use" and
	# left the tunnel down. Wait longer, and only treat it as a conflict if
	# something that is not ours is still holding the port.
	tries=15
	while xwg_udp_port_busy "$port" && ! xwg_port_held_by_us && [ "$tries" -gt 0 ]; do
		tries=$((tries - 1))
		sleep 1
	done
	if xwg_udp_port_busy "$port" && ! xwg_port_held_by_us; then
		xwg_log err "UDP port $port is held by another process; pick another settings.local_port"
		return 1
	fi

	# Pin before anything can install a default route through the tunnel.
	xwg_pin_route "$frontend" || return 1

	xwg_sync_network || {
		xwg_log err "failed to write the WireGuard interface into /etc/config/network"
		xwg_unpin_route
		return 1
	}

	mkdir -p "$XWG_CONF_DIR"
	# The generated config carries the VMess id. A subshell umask keeps it
	# unreadable from the moment the redirect creates it; the chmod below is
	# then belt and braces rather than the only protection.
	if ! ( umask 0077; "$XWG_GENCONFIG" > "$XWG_XRAY_CONF.new" ); then
		xwg_log err "xray config generation failed"
		rm -f "$XWG_XRAY_CONF.new"
		xwg_unpin_route
		return 1
	fi
	chmod 0600 "$XWG_XRAY_CONF.new"
	mv "$XWG_XRAY_CONF.new" "$XWG_XRAY_CONF"

	procd_open_instance xray
	procd_set_param command "$XWG_XRAY_BIN" run -c "$XWG_XRAY_CONF"
	procd_set_param file "$XWG_XRAY_CONF"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_set_param stdout 1
	procd_set_param pidfile "$XWG_STATE_DIR/xray.pid"
	procd_close_instance

	# Runs after procd has actually launched xray. See tunnel-up for why this
	# cannot be inline. The generation token lets a later start invalidate
	# this waiter instead of racing it.
	generation=$(xwg_new_generation)
	/usr/libexec/xray-wg/tunnel-up "$generation" >/dev/null 2>&1 &
}

stop_service() {
	local iface
	iface=$(xwg_get wg iface)

	# Invalidate any tunnel-up still counting down from the previous start,
	# so it cannot ifup after we have torn things down.
	xwg_clear_generation

	[ -n "$iface" ] && ifdown "$iface" 2>/dev/null
	xwg_unpin_route

	# Disconnecting must always leave a working uplink behind, whatever state
	# an older version left the routing table in.
	xwg_repair_upstream_default

	xwg_log info "stopped"
}

service_triggers() {
	procd_add_reload_trigger "xray_wg"
}

reload_service() {
	stop
	start
}

# Report the state the status panel will eventually render.
status_service() {
	local iface port frontend

	iface=$(xwg_get wg iface)
	port=$(xwg_get settings local_port)
	frontend=$(xwg_get server frontend)

	if xwg_udp_port_busy "$port"; then
		echo "xray:      listening on 127.0.0.1:$port"
	else
		echo "xray:      not listening on 127.0.0.1:$port"
	fi

	if xwg_is_pinned; then
		echo "route:     $(ip route get "$frontend" 2>/dev/null | head -n1)"
	else
		echo "route:     $frontend/32 not pinned"
	fi

	if [ -d "/sys/class/net/$iface" ]; then
		echo "wireguard: $iface up"
		wg show "$iface" latest-handshakes 2>/dev/null |
			while read -r peer ts; do
				if [ "${ts:-0}" -gt 0 ]; then
					echo "handshake: $(( $(date +%s) - ts ))s ago"
				else
					echo "handshake: none yet"
				fi
			done
	else
		echo "wireguard: $iface down"
	fi
}

# Used by the LuCI backend so the UI reports exactly what the service enforces.
validate() {
	xwg_validate || return 1
	echo "ok"
}
