#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Second half of service start-up, run detached by the init script.
#
# Usage: tunnel-up <generation_token>
#
# procd starts the xray instance only after start_service() returns, so the
# WireGuard bring-up cannot happen inline: it would race the inbound socket.
# WireGuard would eventually recover on its own (it retries handshakes), but
# waiting for the dokodemo-door socket keeps the first handshake clean and
# makes a genuine failure visible in the log instead of looking like a slow
# connection.
#
# The generation token is re-checked before every side effect. A stop or a
# restart bumps the token, which makes any waiter from an earlier start exit
# quietly rather than bringing the interface up underneath its successor.
# Nothing is locked, so a killed waiter leaves no state behind.

. /usr/share/xray-wg/functions.sh

GENERATION="$1"

if ! xwg_generation_is "$GENERATION"; then
	# Superseded before we even started, or invoked by hand without a token.
	exit 0
fi

iface=$(xwg_get wg iface)
port=$(xwg_get settings local_port)
frontend=$(xwg_get server frontend)

xwg_wait_udp_port "$port" 20 "$GENERATION"
case $? in
	0) ;;
	2) exit 0 ;;  # superseded while waiting
	*)
		xwg_log err "xray did not open 127.0.0.1:$port within 20s; leaving $iface down"
		exit 1
		;;
esac

xwg_generation_is "$GENERATION" || exit 0

# The uplink can settle after xray starts; re-pin before the tunnel's default
# route lands, never after.
xwg_pin_route "$frontend" || {
	xwg_log err "refusing to bring up $iface without a pinned route to $frontend"
	exit 1
}

xwg_firewall_apply

xwg_generation_is "$GENERATION" || exit 0

# netifd will accept "up" for an interface whose proto it does not know and
# then do nothing at all, so wait for it to admit the interface is available
# before asking. See xwg_iface_available for why a restart is the only cure.
if ! xwg_wait_iface_available "$iface" 5; then
	xwg_log warn "netifd has no wireguard proto handler yet; restarting network once"
	/etc/init.d/network restart >/dev/null 2>&1

	xwg_generation_is "$GENERATION" || exit 0

	if ! xwg_wait_iface_available "$iface" 30; then
		xwg_log err "netifd still will not accept $iface; is wireguard-tools installed?"
		exit 1
	fi

	# Restarting the network tears down the uplink and takes the host route
	# with it. Wait for the uplink to have an L3 device again before re-pinning:
	# pinning against a half-built interface fails for a reason that reads like
	# a misconfiguration and is not one.
	xwg_wait_upstream 45 || {
		xwg_log err "uplink did not come back after the network restart"
		exit 1
	}

	xwg_generation_is "$GENERATION" || exit 0

	xwg_pin_route "$frontend" || {
		xwg_log err "lost the pinned route to $frontend across the network restart"
		exit 1
	}
fi

xwg_generation_is "$GENERATION" || exit 0

# ifup is fire-and-forget: it reports success for work netifd may never do, so
# the device appearing is the only thing worth logging success on.
if ifup "$iface" && xwg_wait_device "$iface" 15; then
	xwg_log info "brought up $iface (peer 127.0.0.1:$port -> $frontend)"
else
	xwg_log err "ifup $iface did not produce a device; check 'logread | grep netifd'"
	exit 1
fi
